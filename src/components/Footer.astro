---
/** Starlight's footer (edit link, pagination), with the community links under it. */
import Default from "@astrojs/starlight/components/Footer.astro";
import { footerLinks } from "../footerLinks.ts";
---

<Default />
<nav class="community" aria-label="Gateweave links">
	{
		footerLinks.map((link) => (
			<a href={link.href} rel={link.external ? "noopener" : undefined}>
				{link.label}
			</a>
		))
	}
</nav>

<style>
	.community {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.5rem;
		margin: 1.5rem auto 0;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-hairline);
		font-size: var(--sl-text-sm);
	}
	.community a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.community a:hover {
		color: var(--sl-color-white);
		text-decoration: underline;
	}
</style>
