{
	"name": "gateweave-docs",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "astro dev --port 4730",
		"sync": "node scripts/sync.ts",
		"build": "astro build",
		"preview": "astro build && wrangler dev --port 4730",
		"deploy": "astro build && wrangler deploy",
		"check": "biome check && astro check",
		"format": "biome check --write",
		"test": "vitest run",
		"verify": "pnpm check && pnpm test && pnpm build"
	},
	"dependencies": {
		"@astrojs/starlight": "0.42.11",
		"@fontsource-variable/inter": "5.3.0",
		"astro": "7.4.11",
		"astro-mermaid": "2.2.0",
		"mermaid": "12.3.0",
		"sharp": "0.35.5",
		"starlight-llms-txt": "0.12.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@biomejs/biome": "2.6.6",
		"@types/mdast": "4.0.4",
		"@types/node": "24.19.2",
		"mdast-util-from-markdown": "2.1.0",
		"mdast-util-gfm": "3.1.0",
		"mdast-util-to-string": "4.0.0",
		"micromark-extension-gfm": "3.0.0",
		"typescript": "6.0.3",
		"unist-util-visit": "5.2.0",
		"vitest": "5.1.0",
		"wrangler": "4.161.0"
	}
}
