{
	"name": "gateweave-docs",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "astro dev --port 4730",
		"sync": "node scripts/sync.ts",
		"whats-new": "node scripts/whats-new-local.ts",
		"build": "astro build && node scripts/check-social-cards.ts",
		"preview": "pnpm build && wrangler dev --port 4730",
		"deploy": "pnpm build && wrangler deploy",
		"check": "biome check && astro check",
		"format": "biome check --write",
		"test": "vitest run",
		"verify": "pnpm check && pnpm test && pnpm build"
	},
	"dependencies": {
		"@astrojs/starlight": "0.43.1",
		"@fontsource-variable/inter": "5.3.0",
		"astro": "7.4.13",
		"astro-mermaid": "2.2.0",
		"mermaid": "12.3.0",
		"sharp": "0.35.5",
		"starlight-llms-txt": "0.12.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@astrojs/markdown-satteri": "0.4.10",
		"@biomejs/biome": "2.6.8",
		"@fontsource/inter": "5.3.0",
		"@types/mdast": "4.0.4",
		"@types/node": "26.6.7",
		"@types/sax": "1.2.7",
		"astro-og-canvas": "0.13.3",
		"canvaskit-wasm": "0.42.0",
		"mdast-util-from-markdown": "2.1.0",
		"mdast-util-gfm": "3.1.0",
		"mdast-util-to-string": "4.0.0",
		"micromark-extension-gfm": "3.0.0",
		"parse5": "8.1.1",
		"rehype-parse": "9.0.1",
		"rehype-remark": "10.0.1",
		"remark-gfm": "4.0.1",
		"remark-stringify": "11.0.0",
		"sax": "1.6.1",
		"typescript": "6.0.3",
		"unified": "11.0.5",
		"unist-util-visit": "5.2.0",
		"vitest": "5.1.1",
		"wrangler": "4.167.0"
	}
}
